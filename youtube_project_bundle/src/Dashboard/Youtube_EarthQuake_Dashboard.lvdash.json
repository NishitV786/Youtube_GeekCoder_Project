{
  "datasets": [
    {
      "name": "af6e3f16",
      "displayName": "Earthquake_Detail",
      "queryLines": [
        "select * from silver.earthquake_data_final"
      ],
      "catalog": "youtube_dev",
      "schema": "default"
    },
    {
      "name": "9cc0811d",
      "displayName": "Earthquake_Type",
      "queryLines": [
        "SELECT\r\n",
        "  COUNT(*) AS total_magnitude_bucket,\r\n",
        "  magnitude_bucket\r\n",
        "FROM\r\n",
        "  (\r\n",
        "    SELECT\r\n",
        "      CASE\r\n",
        "        WHEN mag < 2 THEN 'Micro (<2)'\r\n",
        "        WHEN mag BETWEEN 2 AND 3 THEN 'Minor (2–3)'\r\n",
        "        WHEN mag BETWEEN 3 AND 4 THEN 'Light (3–4)'\r\n",
        "        ELSE 'Moderate+ (4+)'\r\n",
        "      END AS magnitude_bucket\r\n",
        "    FROM\r\n",
        "      silver.earthquake_data_final\r\n",
        "  ) t\r\n",
        "GROUP BY\r\n",
        "  magnitude_bucket"
      ],
      "catalog": "youtube_dev",
      "schema": "default"
    },
    {
      "name": "36660551",
      "displayName": "Earthquake_By_Country",
      "queryLines": [
        "       SELECT\r\n",
        "       count(*) AS event_count,\r\n",
        "         CASE \r\n",
        "         WHEN size(split(place, ', ')) = 1 THEN split(place, ', ')[0]\r\n",
        "          ELSE split(place, ', ')[1]\r\n",
        "          END AS country\r\n",
        "        FROM (\r\n",
        "          SELECT \r\n",
        "             time,\r\n",
        "           title,\r\n",
        "           mag,\r\n",
        "           longitude,\r\n",
        "           place,\r\n",
        "           latitude\r\n",
        "          FROM silver.earthquake_data_final)\r\n",
        "        \r\n",
        "        GROUP BY country"
      ],
      "catalog": "youtube_dev",
      "schema": "default"
    }
  ],
